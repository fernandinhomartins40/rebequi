// Prisma Schema for Rebequi E-commerce
// learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// USER MODEL - Authentication & Authorization
// ============================================================================
model User {
  externalCustomerLinks ExternalCustomerLink[]
  commercialAssignmentReads CommercialAssignmentRead[]
  sellerGoals SellerGoalRevision[] @relation("SellerGoalOwner")
  deliveryRuns DeliveryRun[] @relation("DeliveryRunDriver")
  driverFulfillments Fulfillment[] @relation("FulfillmentDriver")
  assignedSellerId String?
  assignedSeller User? @relation("CustomerSeller", fields: [assignedSellerId], references: [id], onDelete: SetNull)
  assignedCustomers User[] @relation("CustomerSeller")
  assignmentVersion Int @default(0)
  assignedLeads LeadCapture[] @relation("LeadSeller")
  assignedQuotes QuoteRequest[] @relation("QuoteSeller")
  assignedOrders CustomerOrder[] @relation("OrderSeller")
  assignedSales Sale[] @relation("SaleSeller")
  id                 String         @id @default(cuid())
  email              String         @unique
  name               String
  password           String         // Hashed with bcrypt
  role               UserRole       @default(CUSTOMER)
  whatsapp           String?        @unique
  isActive           Boolean        @default(true)
  isProvisional      Boolean        @default(false)
  mustChangePassword Boolean        @default(false)
  // CRM — relacionamento com o cliente (aplica-se a usuários CUSTOMER)
  customerStage      CustomerStage  @default(NEW)
  customerStageManual Boolean       @default(false) // true = estágio travado pelo lojista (não deriva automático)
  customerTags       String[]       @default([])
  followUpAt         DateTime?      // Lembrete de retorno
  lastContactedAt    DateTime?      // Último contato registrado
  leads              LeadCapture[]
  customerOrders     CustomerOrder[]
  quoteRequests      QuoteRequest[]
  partnerProfile     PartnerProfile?
  sales              Sale[]         @relation("SaleCustomer")
  salesRegistered    Sale[]         @relation("SaleRegisteredBy")
  customerNotes      CustomerNote[] @relation("CustomerNoteCustomer")
  authoredNotes      CustomerNote[] @relation("CustomerNoteAuthor")
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@index([email])
  @@index([whatsapp])
  @@index([role])
  @@index([isActive])
  @@index([isProvisional])
  @@index([customerStage])
  @@index([followUpAt])
  @@index([assignedSellerId, role])
  @@map("users")
}

enum UserRole {
  DRIVER
  WAREHOUSE
  ADMIN
  MANAGER
  CATALOG_MANAGER
  MARKETING
  SALES
  CUSTOMER
}

enum CustomerStage {
  NEW         // Cadastrado, sem interação comercial
  QUOTING     // Enviou/está com orçamento em aberto
  NEGOTIATING // Em negociação ativa
  CUSTOMER    // Já fechou ao menos uma venda
  RECURRING   // Comprou mais de uma vez
  INACTIVE    // Sem interação há muito tempo / arquivado
}

// ============================================================================
// CUSTOMER NOTE - Anotações e follow-up do CRM
// ============================================================================
model CustomerNote {
  id         String   @id @default(cuid())
  customerId String
  customer   User     @relation("CustomerNoteCustomer", fields: [customerId], references: [id], onDelete: Cascade)
  authorId   String?
  author     User?    @relation("CustomerNoteAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  body       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([customerId, createdAt])
  @@index([authorId])
  @@map("customer_notes")
}

// ============================================================================
// CATEGORY MODEL - Product Categories
// ============================================================================
model Category {
  externalLinks ExternalCategoryLink[]
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  icon        String?   // Lucide icon name (e.g., "Wrench", "Package")
  image       String?   // URL or path to category image
  description String?
  isActive    Boolean   @default(true)
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime? // Soft delete timestamp

  @@index([slug])
  @@index([isActive])
  @@index([deletedAt])
  @@map("categories")
}

model ExternalCategoryLink {
  id String @id @default(cuid())
  source String
  externalId String
  categoryId String
  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  requestKey String @unique
  fingerprint String
  actorId String
  createdAt DateTime @default(now())
  revokedAt DateTime?
  revokedById String?
  revokedReason String?
  @@index([categoryId])
  @@index([source, externalId])
  @@map("external_category_links")
}

model ExternalCustomerLink {
  id String @id @default(cuid())
  source String
  externalId String
  customerId String
  customer User @relation(fields: [customerId], references: [id], onDelete: Restrict)
  requestKey String @unique
  fingerprint String
  actorId String
  createdAt DateTime @default(now())
  revokedAt DateTime?
  revokedById String?
  revokedReason String?
  @@index([customerId])
  @@index([source, externalId])
  @@map("external_customer_links")
}

// ============================================================================
// PRODUCT MODEL - E-commerce Products
// ============================================================================
model Product {
  unitPolicies ProductUnitPolicy[]
  externalLinks ExternalProductLink[]
  id            String         @id @default(cuid())
  name          String
  slug          String         @unique
  sku           String?        @unique
  price         Float          // Current price in BRL
  originalPrice Float?         // Original price (before discount)
  description   String?
  shortDesc     String?        // Short description for cards
  isOffer       Boolean        @default(false) // Is in promotional offer
  isNew         Boolean        @default(false) // Is a new product
  isFeatured    Boolean        @default(false) // Featured on homepage
  discount      Int?           // Discount percentage (0-100)
  stock         Int            @default(0) // Current stock quantity
  reservedStock Int            @default(0)
  technicalSpec ProductTechnicalSpec?
  reservations  StockReservation[]
  minStock      Int            @default(0) // Alert when stock is low
  weight        Float?         // Weight in kg
  dimensions    String?        // Dimensions (e.g., "10x20x30 cm")
  categoryId    String
  category      Category       @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  customerOrderItems CustomerOrderItem[]
  images        ProductImage[]
  promotions    PromotionProduct[]
  quoteItems    QuoteItem[]
  aliases       ProductAlias[]
  saleItems     SaleItem[]
  stockMovements StockMovement[]
  channelListings ChannelListing[]
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  deletedAt     DateTime?      // Soft delete timestamp

  @@index([categoryId])
  @@index([slug])
  @@index([sku])
  @@index([isOffer])
  @@index([isNew])
  @@index([isFeatured])
  @@index([isActive])
  @@index([deletedAt])
  @@index([price])
  @@map("products")
}

model ExternalProductLink {
  id String @id @default(cuid())
  source String
  externalId String
  productId String
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  requestKey String @unique
  fingerprint String
  actorId String
  createdAt DateTime @default(now())
  revokedAt DateTime?
  revokedById String?
  revokedReason String?
  @@index([productId])
  @@index([source, externalId])
  @@map("external_product_links")
}

model ExternalProductImportBatch {
  reviews ExternalProductImportReview[]
  id String @id @default(cuid())
  source String
  requestKey String @unique
  fingerprint String
  actorId String
  rows Json
  preview Json
  createdAt DateTime @default(now())
  @@index([source, createdAt])
  @@map("external_product_import_batches")
}

model ExternalProductImportReview {
  id String @id @default(cuid())
  batchId String
  batch ExternalProductImportBatch @relation(fields: [batchId], references: [id], onDelete: Restrict)
  requestKey String @unique
  actorId String
  fingerprint String
  summary Json
  changedRows Int[]
  createdAt DateTime @default(now())
  @@index([batchId, createdAt])
  @@map("external_product_import_reviews")
}

model ProductUnitPolicy {
  id String @id @default(cuid())
  productId String
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  version Int
  requestKey String @unique
  fingerprint String
  commercialUnit String
  stockUnit String
  stockPerCommercialUnit Decimal @db.Decimal(12, 3)
  quantityStep Decimal @db.Decimal(12, 3)
  actorId String
  reason String
  createdAt DateTime @default(now())
  @@unique([productId, version])
  @@map("product_unit_policies")
}

// ============================================================================
// PRODUCT IMAGE MODEL - Multiple images per product
// ============================================================================
model ProductImage {
  id        String   @id @default(cuid())
  url       String   // Image URL or path
  alt       String?  // Alt text for SEO
  order     Int      @default(0) // Display order (0 = first)
  isPrimary Boolean  @default(false) // Main product image
  storageKey String? // Relative key inside uploads storage
  filename  String?  // Persisted file name
  mimeType  String?  // Stored mime type
  size      Int?     // File size in bytes
  width     Int?     // Stored image width
  height    Int?     // Stored image height
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
  @@index([isPrimary])
  @@index([order])
  @@index([storageKey])
  @@map("product_images")
}

enum PromotionTheme {
  GOLD
  BLUE
  GREEN
  RED
  SLATE
}

enum PromotionKind {
  COLLECTION
  SINGLE_PRODUCT
}

enum PromotionOfferPricingMode {
  FIXED_PRICE
  PERCENTAGE_DISCOUNT
  BUY_X_PAY_Y
  BULK_PERCENTAGE
}

model Promotion {
  id              String             @id @default(cuid())
  name            String
  slug            String             @unique
  kind            PromotionKind      @default(COLLECTION)
  eyebrow         String?
  title           String
  subtitle        String?
  description     String?
  badgeText       String?
  ctaLabel        String?
  disclaimer      String?
  themeTone       PromotionTheme     @default(GOLD)
  imageUrl        String
  imageAlt        String?
  imageStorageKey String?
  imageFilename   String?
  imageMimeType   String?
  imageSize       Int?
  imageWidth      Int?
  imageHeight     Int?
  offerPricingMode       PromotionOfferPricingMode?
  offerPromotionalPrice  Float?
  offerDiscountPercentage Float?
  offerMinimumQuantity   Int?
  offerPayQuantity       Int?
  startsAt        DateTime?
  expiresAt       DateTime?
  sortOrder       Int                @default(0)
  products        PromotionProduct[]
  isActive        Boolean            @default(true)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  deletedAt       DateTime?

  @@index([slug])
  @@index([kind])
  @@index([offerPricingMode])
  @@index([themeTone])
  @@index([sortOrder])
  @@index([isActive])
  @@index([startsAt])
  @@index([expiresAt])
  @@index([deletedAt])
  @@map("promotions")
}

model PromotionProduct {
  id          String    @id @default(cuid())
  promotionId String
  productId   String
  order       Int       @default(0)
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([promotionId, productId])
  @@index([promotionId, order])
  @@index([productId])
  @@map("promotion_products")
}

enum LeadStatus {
  STARTED
  QUOTE_DRAFTED
  QUOTE_SUBMITTED
  CONTACTED
  ARCHIVED
}

enum QuoteStatus {
  DRAFT
  SUBMITTED
  IN_REVIEW
  RESPONDED
  ARCHIVED
}

enum QuoteOcrStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  SKIPPED
}

enum OrderStatus {
  PENDING_WHATSAPP
  WHATSAPP_REDIRECTED
  IN_RECOVERY
  COMPLETED
  CANCELED
}

model LeadCapture {
  assignedSellerId String?
  assignedSeller User? @relation("LeadSeller", fields: [assignedSellerId], references: [id], onDelete: SetNull)
  assignmentVersion Int @default(0)
  id           String         @id @default(cuid())
  userId       String
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  nameSnapshot String
  whatsapp     String
  source       String         @default("public_quote")
  status       LeadStatus     @default(STARTED)
  notes        String?
  completedAt  DateTime?
  quotes       QuoteRequest[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([userId])
  @@index([whatsapp])
  @@index([status])
  @@map("lead_captures")
  @@index([assignedSellerId, createdAt])
}

model QuoteRequest {
  commercialCreationKey String? @unique
  commercialCreationFingerprint String?
  createdById String?
  assignedSellerId String?
  assignedSeller User? @relation("QuoteSeller", fields: [assignedSellerId], references: [id], onDelete: SetNull)
  assignmentVersion Int @default(0)
  id                 String       @id @default(cuid())
  referenceCode      String       @unique
  partnerEstimate    MaterialEstimate?
  proposals QuoteProposal[]
  proposalOrderId String? @unique
  proposalOrder CustomerOrder? @relation(fields: [proposalOrderId], references: [id], onDelete: SetNull)
  acceptedProposalVersion Int?
  proposalAcceptedAt DateTime?
  // Null while the quote is an anonymous draft: the customer photographs the
  // list first and only identifies themselves when submitting.
  userId             String?
  user               User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
  leadId             String?
  lead               LeadCapture? @relation(fields: [leadId], references: [id], onDelete: SetNull)
  status             QuoteStatus  @default(DRAFT)
  source             String       @default("customer_dashboard")
  title              String?
  customerNote       String?
  ocrStatus          QuoteOcrStatus @default(PENDING)
  ocrText            String?
  ocrConfidence      Float?
  ocrError           String?
  ocrAttempts        Int          @default(0)
  ocrEngine          String?
  ocrModelId         String?
  // Opaque secret handed to the browser so an anonymous draft can be edited
  // and submitted before any account exists.
  anonymousToken     String?      @unique
  anonymousExpiresAt DateTime?
  ocrRuns            OcrRun[]
  documentUrl        String
  documentStorageKey String?
  documentFilename   String?
  documentMimeType   String?
  documentSize       Int?
  documentWidth      Int?
  documentHeight     Int?
  items              QuoteItem[]
  submittedAt        DateTime?
  reviewedAt         DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@index([referenceCode])
  @@index([userId])
  @@index([leadId])
  @@index([status])
  @@index([ocrStatus])
  @@index([submittedAt])
  @@index([anonymousExpiresAt])
  @@map("quote_requests")
  @@index([assignedSellerId, createdAt])
}

/// One recognition attempt. Answers "is the AI worth it?" and "which model
/// actually performs?" — impossible to tell before this existed.
model OcrRun {
  id                    String       @id @default(cuid())
  quoteRequestId        String
  quoteRequest          QuoteRequest @relation(fields: [quoteRequestId], references: [id], onDelete: Cascade)
  engine                String
  modelId               String?
  success               Boolean      @default(false)
  durationMs            Int          @default(0)
  promptTokens          Int?
  completionTokens      Int?
  costUsd               Float?
  itemsDetected         Int          @default(0)
  itemsMatched          Int          @default(0)
  /// Filled in at submit time: the real quality signal, since it measures what
  /// the customer had to fix rather than what the model claimed.
  itemsEditedByCustomer Int?
  errorMessage          String?
  createdAt             DateTime     @default(now())

  @@index([quoteRequestId])
  @@index([createdAt])
  @@index([engine, success])
  @@map("ocr_runs")
}

/// Vocabulary learned from customer corrections: when someone fixes a badly
/// recognised line into a real product, that pairing is remembered so the next
/// customer writing the same thing gets matched automatically.
model ProductAlias {
  id           String   @id @default(cuid())
  /// Normalised source text (output of normalizeDomainText).
  normalizedText String
  productId    String
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  occurrences  Int      @default(1)
  /// Only aliases confirmed enough times are trusted for matching.
  isApproved   Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([normalizedText, productId])
  @@index([normalizedText, isApproved])
  @@map("product_aliases")
}

model QuoteItem {
  id                    String       @id @default(cuid())
  quoteRequestId        String
  quoteRequest          QuoteRequest @relation(fields: [quoteRequestId], references: [id], onDelete: Cascade)
  productId             String?
  product               Product?     @relation(fields: [productId], references: [id], onDelete: SetNull)
  name                  String
  quantity              Float        @default(1)
  unit                  String?
  notes                 String?
  confidence            Float?
  recognitionSourceLine String?
  position              Int          @default(0)
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  @@index([quoteRequestId, position])
  @@index([productId])
  @@map("quote_items")
}

model CustomerOrder {
  assignedSellerId String?
  assignedSeller User? @relation("OrderSeller", fields: [assignedSellerId], references: [id], onDelete: SetNull)
  assignmentVersion Int @default(0)
  partnerReferral PartnerReferral?
  id                   String              @id @default(cuid())
  referenceCode        String              @unique
  proposalQuote QuoteRequest?
  userId               String
  user                 User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  status               OrderStatus         @default(PENDING_WHATSAPP)
  source               String              @default("public_cart")
  customerNameSnapshot String
  customerWhatsapp     String
  customerNote         String?
  internalNotes        String?
  whatsappUrl          String?
  whatsappMessage      String?
  whatsappRedirectedAt DateTime?
  recoveryStartedAt    DateTime?
  completedAt          DateTime?
  canceledAt           DateTime?
  items                CustomerOrderItem[]
  reservations         StockReservation[]
  sale                 Sale?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  @@index([referenceCode])
  @@index([userId])
  @@index([status])
  @@index([customerWhatsapp])
  @@index([whatsappRedirectedAt])
  @@map("customer_orders")
  @@index([assignedSellerId, createdAt])
}

// ============================================================================
// SALE MODELS - Registered sales (fecha o ciclo de venda / faturamento)
// ============================================================================
enum PaymentMethod {
  PIX
  CASH
  CARD
  INSTALLMENT
}

enum SaleStatus {
  PAID
  PENDING_PAYMENT
  CANCELED
}

model Sale {
  fulfillment Fulfillment?
  assignedSellerId String?
  creditedSellerId String?
  assignedSeller User? @relation("SaleSeller", fields: [assignedSellerId], references: [id], onDelete: SetNull)
  assignmentVersion Int @default(0)
  accountingVersion Int @default(0)
  returnVersion Int @default(0)
  statusVersion Int @default(1)
  returns SaleReturn[]
  partnerLedger PartnerLedgerEntry[]
  id                   String        @id @default(cuid())
  referenceCode        String        @unique
  idempotencyKey       String?       @unique
  requestFingerprint   String?
  status               SaleStatus    @default(PAID)
  paymentMethod        PaymentMethod
  // Vínculos opcionais: cliente cadastrado e pedido de origem (checkout WhatsApp)
  customerId           String?
  customer             User?         @relation("SaleCustomer", fields: [customerId], references: [id], onDelete: SetNull)
  orderId              String?       @unique
  order                CustomerOrder? @relation(fields: [orderId], references: [id], onDelete: SetNull)
  // Quem registrou a venda no painel (colaborador interno)
  registeredById       String?
  registeredBy         User?         @relation("SaleRegisteredBy", fields: [registeredById], references: [id], onDelete: SetNull)
  // Snapshot do cliente para venda de balcão sem cadastro
  customerNameSnapshot String?
  customerWhatsapp     String?
  // Valores monetários
  subtotal             Float         @default(0) // Soma dos itens (bruto)
  discount             Float         @default(0) // Desconto aplicado no total
  total                Float         @default(0) // subtotal - discount (líquido)
  notes                String?
  paidAt               DateTime?
  canceledAt           DateTime?
  items                SaleItem[]
  stockMovements       StockMovement[]
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  @@index([referenceCode])
  @@index([status])
  @@index([paymentMethod])
  @@index([customerId])
  @@index([registeredById])
  @@index([creditedSellerId, paidAt], map: "sales_credited_seller_paid_at_idx")
  @@index([createdAt])
  @@map("sales")
}

model CommercialAssignmentAudit {
  reads CommercialAssignmentRead[]
  id String @id @default(cuid())
  resourceKind String
  resourceId String
  previousSellerId String?
  nextSellerId String?
  version Int
  actorId String
  reason String
  createdAt DateTime @default(now())
  @@unique([resourceKind, resourceId, version])
  @@index([resourceKind, resourceId, createdAt])
  @@index([nextSellerId, createdAt], map: "commercial_assignment_recipient_created")
  @@map("commercial_assignment_audits")
}

model CommercialAssignmentRead {
  id String @id @default(cuid())
  assignmentId String
  assignment CommercialAssignmentAudit @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  readAt DateTime @default(now())
  @@unique([assignmentId, userId], map: "commercial_assignment_read_unique")
  @@index([userId, readAt], map: "commercial_assignment_read_user")
  @@map("commercial_assignment_reads")
}

model SellerGoalRevision {
  id String @id @default(cuid())
  sellerId String
  seller User @relation("SellerGoalOwner", fields: [sellerId], references: [id], onDelete: Restrict)
  month String
  version Int
  targetCents BigInt
  requestKey String @unique
  fingerprint String
  actorId String
  reason String
  createdAt DateTime @default(now())
  @@unique([sellerId, month, version], map: "seller_goal_revision_version")
  @@index([sellerId, month], map: "seller_goal_revision_seller_month")
  @@map("seller_goal_revisions")
}

model SellerCommissionDraft {
  id String @id @default(cuid())
  version Int @unique
  requestKey String @unique
  fingerprint String
  effectiveMonth String
  basis String
  eligibleRole String
  basisPoints Int
  maturityDays Int
  actorId String
  reason String
  createdAt DateTime @default(now())
  @@map("seller_commission_drafts")
}

model LogisticsVehicle {
  deliveryRuns DeliveryRun[]
  id           String   @id @default(cuid())
  plate        String   @unique
  label        String
  maxLoadKg    Decimal? @db.Decimal(12, 3)
  maxVolumeM3  Decimal? @db.Decimal(12, 3)
  restrictions String?
  active       Boolean  @default(true)
  version      Int      @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  events       LogisticsVehicleEvent[]

  @@index([active, createdAt])
  @@map("logistics_vehicles")
}

model LogisticsVehicleEvent {
  id          String @id @default(cuid())
  vehicleId   String
  vehicle     LogisticsVehicle @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  version     Int
  requestKey  String @unique
  fingerprint String
  actorId     String
  snapshot    Json
  reason      String
  createdAt   DateTime @default(now())

  @@unique([vehicleId, version])
  @@map("logistics_vehicle_events")
}

model Fulfillment {
  priority Int @default(1)
  deliveryStops DeliveryRunStop[]
  driverId String?
  driver User? @relation("FulfillmentDriver", fields: [driverId], references: [id], onDelete: SetNull)
  id String @id @default(cuid())
  saleId String @unique
  sale Sale @relation(fields: [saleId], references: [id], onDelete: Restrict)
  mode String @default("UNDEFINED")
  status String @default("AWAITING_DETAILS")
  version Int @default(1)
  address String?
  region String?
  scheduledAt DateTime?
  notes String?
  items FulfillmentItem[]
  events FulfillmentEvent[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status, createdAt])
  @@index([driverId, status, createdAt])
  @@index([priority(sort: Desc), createdAt, id])
  @@map("fulfillments")
}

model DeliveryRun {
  loadSnapshot Json?
  loadedAt DateTime?
  departedAt DateTime?
  id String @id @default(cuid())
  label String
  driverId String
  driver User @relation("DeliveryRunDriver", fields: [driverId], references: [id], onDelete: Restrict)
  vehicleId String
  vehicle LogisticsVehicle @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  scheduledAt DateTime
