// Prisma Schema for Rebequi E-commerce
// learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// USER MODEL - Authentication & Authorization
// ============================================================================
model User {
  id                 String         @id @default(cuid())
  email              String         @unique
  name               String
  password           String         // Hashed with bcrypt
  role               UserRole       @default(CUSTOMER)
  whatsapp           String?        @unique
  isActive           Boolean        @default(true)
  isProvisional      Boolean        @default(false)
  mustChangePassword Boolean        @default(false)
  // CRM — relacionamento com o cliente (aplica-se a usuários CUSTOMER)
  customerStage      CustomerStage  @default(NEW)
  customerStageManual Boolean       @default(false) // true = estágio travado pelo lojista (não deriva automático)
  customerTags       String[]       @default([])
  followUpAt         DateTime?      // Lembrete de retorno
  lastContactedAt    DateTime?      // Último contato registrado
  leads              LeadCapture[]
  customerOrders     CustomerOrder[]
  quoteRequests      QuoteRequest[]
  partnerProfile     PartnerProfile?
  sales              Sale[]         @relation("SaleCustomer")
  salesRegistered    Sale[]         @relation("SaleRegisteredBy")
  customerNotes      CustomerNote[] @relation("CustomerNoteCustomer")
  authoredNotes      CustomerNote[] @relation("CustomerNoteAuthor")
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@index([email])
  @@index([whatsapp])
  @@index([role])
  @@index([isActive])
  @@index([isProvisional])
  @@index([customerStage])
  @@index([followUpAt])
  @@map("users")
}

enum UserRole {
  ADMIN
  MANAGER
  CATALOG_MANAGER
  MARKETING
  SALES
  CUSTOMER
}

enum CustomerStage {
  NEW         // Cadastrado, sem interação comercial
  QUOTING     // Enviou/está com orçamento em aberto
  NEGOTIATING // Em negociação ativa
  CUSTOMER    // Já fechou ao menos uma venda
  RECURRING   // Comprou mais de uma vez
  INACTIVE    // Sem interação há muito tempo / arquivado
}

// ============================================================================
// CUSTOMER NOTE - Anotações e follow-up do CRM
// ============================================================================
model CustomerNote {
  id         String   @id @default(cuid())
  customerId String
  customer   User     @relation("CustomerNoteCustomer", fields: [customerId], references: [id], onDelete: Cascade)
  authorId   String?
  author     User?    @relation("CustomerNoteAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  body       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([customerId, createdAt])
  @@index([authorId])
  @@map("customer_notes")
}

// ============================================================================
// CATEGORY MODEL - Product Categories
// ============================================================================
model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  icon        String?   // Lucide icon name (e.g., "Wrench", "Package")
  image       String?   // URL or path to category image
  description String?
  isActive    Boolean   @default(true)
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime? // Soft delete timestamp

  @@index([slug])
  @@index([isActive])
  @@index([deletedAt])
  @@map("categories")
}

// ============================================================================
// PRODUCT MODEL - E-commerce Products
// ============================================================================
model Product {
  id            String         @id @default(cuid())
  name          String
  slug          String         @unique
  sku           String?        @unique
  price         Float          // Current price in BRL
  originalPrice Float?         // Original price (before discount)
  description   String?
  shortDesc     String?        // Short description for cards
  isOffer       Boolean        @default(false) // Is in promotional offer
  isNew         Boolean        @default(false) // Is a new product
  isFeatured    Boolean        @default(false) // Featured on homepage
  discount      Int?           // Discount percentage (0-100)
  stock         Int            @default(0) // Current stock quantity
  reservedStock Int            @default(0)
  technicalSpec ProductTechnicalSpec?
  reservations  StockReservation[]
  minStock      Int            @default(0) // Alert when stock is low
  weight        Float?         // Weight in kg
  dimensions    String?        // Dimensions (e.g., "10x20x30 cm")
  categoryId    String
  category      Category       @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  customerOrderItems CustomerOrderItem[]
  images        ProductImage[]
  promotions    PromotionProduct[]
  quoteItems    QuoteItem[]
  aliases       ProductAlias[]
  saleItems     SaleItem[]
  stockMovements StockMovement[]
  channelListings ChannelListing[]
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  deletedAt     DateTime?      // Soft delete timestamp

  @@index([categoryId])
  @@index([slug])
  @@index([sku])
  @@index([isOffer])
  @@index([isNew])
  @@index([isFeatured])
  @@index([isActive])
  @@index([deletedAt])
  @@index([price])
  @@map("products")
}

// ============================================================================
// PRODUCT IMAGE MODEL - Multiple images per product
// ============================================================================
model ProductImage {
  id        String   @id @default(cuid())
  url       String   // Image URL or path
  alt       String?  // Alt text for SEO
  order     Int      @default(0) // Display order (0 = first)
  isPrimary Boolean  @default(false) // Main product image
  storageKey String? // Relative key inside uploads storage
  filename  String?  // Persisted file name
  mimeType  String?  // Stored mime type
  size      Int?     // File size in bytes
  width     Int?     // Stored image width
  height    Int?     // Stored image height
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
  @@index([isPrimary])
  @@index([order])
  @@index([storageKey])
  @@map("product_images")
}

enum PromotionTheme {
  GOLD
  BLUE
  GREEN
  RED
  SLATE
}

enum PromotionKind {
  COLLECTION
  SINGLE_PRODUCT
}

enum PromotionOfferPricingMode {
  FIXED_PRICE
  PERCENTAGE_DISCOUNT
  BUY_X_PAY_Y
  BULK_PERCENTAGE
}

model Promotion {
  id              String             @id @default(cuid())
  name            String
  slug            String             @unique
  kind            PromotionKind      @default(COLLECTION)
  eyebrow         String?
  title           String
  subtitle        String?
  description     String?
  badgeText       String?
  ctaLabel        String?
  disclaimer      String?
  themeTone       PromotionTheme     @default(GOLD)
  imageUrl        String
  imageAlt        String?
  imageStorageKey String?
  imageFilename   String?
  imageMimeType   String?
  imageSize       Int?
  imageWidth      Int?
  imageHeight     Int?
  offerPricingMode       PromotionOfferPricingMode?
  offerPromotionalPrice  Float?
  offerDiscountPercentage Float?
  offerMinimumQuantity   Int?
  offerPayQuantity       Int?
  startsAt        DateTime?
  expiresAt       DateTime?
  sortOrder       Int                @default(0)
  products        PromotionProduct[]
  isActive        Boolean            @default(true)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  deletedAt       DateTime?

  @@index([slug])
  @@index([kind])
  @@index([offerPricingMode])
  @@index([themeTone])
  @@index([sortOrder])
  @@index([isActive])
  @@index([startsAt])
  @@index([expiresAt])
  @@index([deletedAt])
  @@map("promotions")
}

model PromotionProduct {
  id          String    @id @default(cuid())
  promotionId String
  productId   String
  order       Int       @default(0)
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([promotionId, productId])
  @@index([promotionId, order])
  @@index([productId])
  @@map("promotion_products")
}

enum LeadStatus {
  STARTED
  QUOTE_DRAFTED
  QUOTE_SUBMITTED
  CONTACTED
  ARCHIVED
}

enum QuoteStatus {
  DRAFT
  SUBMITTED
  IN_REVIEW
  RESPONDED
  ARCHIVED
}

enum QuoteOcrStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  SKIPPED
}

enum OrderStatus {
  PENDING_WHATSAPP
  WHATSAPP_REDIRECTED
  IN_RECOVERY
  COMPLETED
  CANCELED
}

model LeadCapture {
  id           String         @id @default(cuid())
  userId       String
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  nameSnapshot String
  whatsapp     String
  source       String         @default("public_quote")
  status       LeadStatus     @default(STARTED)
  notes        String?
  completedAt  DateTime?
  quotes       QuoteRequest[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([userId])
  @@index([whatsapp])
  @@index([status])
  @@map("lead_captures")
}

model QuoteRequest {
  id                 String       @id @default(cuid())
  referenceCode      String       @unique
  partnerEstimate    MaterialEstimate?
  proposals QuoteProposal[]
  proposalOrderId String? @unique
  proposalOrder CustomerOrder? @relation(fields: [proposalOrderId], references: [id], onDelete: SetNull)
  acceptedProposalVersion Int?
  proposalAcceptedAt DateTime?
  // Null while the quote is an anonymous draft: the customer photographs the
  // list first and only identifies themselves when submitting.
  userId             String?
  user               User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
  leadId             String?
  lead               LeadCapture? @relation(fields: [leadId], references: [id], onDelete: SetNull)
  status             QuoteStatus  @default(DRAFT)
  source             String       @default("customer_dashboard")
  title              String?
  customerNote       String?
  ocrStatus          QuoteOcrStatus @default(PENDING)
  ocrText            String?
  ocrConfidence      Float?
  ocrError           String?
  ocrAttempts        Int          @default(0)
  ocrEngine          String?
  ocrModelId         String?
  // Opaque secret handed to the browser so an anonymous draft can be edited
  // and submitted before any account exists.
  anonymousToken     String?      @unique
  anonymousExpiresAt DateTime?
  ocrRuns            OcrRun[]
  documentUrl        String
  documentStorageKey String?
  documentFilename   String?
  documentMimeType   String?
  documentSize       Int?
  documentWidth      Int?
  documentHeight     Int?
  items              QuoteItem[]
  submittedAt        DateTime?
  reviewedAt         DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@index([referenceCode])
  @@index([userId])
  @@index([leadId])
  @@index([status])
  @@index([ocrStatus])
  @@index([submittedAt])
  @@index([anonymousExpiresAt])
  @@map("quote_requests")
}

/// One recognition attempt. Answers "is the AI worth it?" and "which model
/// actually performs?" — impossible to tell before this existed.
model OcrRun {
  id                    String       @id @default(cuid())
  quoteRequestId        String
  quoteRequest          QuoteRequest @relation(fields: [quoteRequestId], references: [id], onDelete: Cascade)
  engine                String
  modelId               String?
  success               Boolean      @default(false)
  durationMs            Int          @default(0)
  promptTokens          Int?
  completionTokens      Int?
  costUsd               Float?
  itemsDetected         Int          @default(0)
  itemsMatched          Int          @default(0)
  /// Filled in at submit time: the real quality signal, since it measures what
  /// the customer had to fix rather than what the model claimed.
  itemsEditedByCustomer Int?
  errorMessage          String?
  createdAt             DateTime     @default(now())

  @@index([quoteRequestId])
  @@index([createdAt])
  @@index([engine, success])
  @@map("ocr_runs")
}

/// Vocabulary learned from customer corrections: when someone fixes a badly
/// recognised line into a real product, that pairing is remembered so the next
/// customer writing the same thing gets matched automatically.
model ProductAlias {
  id           String   @id @default(cuid())
  /// Normalised source text (output of normalizeDomainText).
  normalizedText String
  productId    String
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  occurrences  Int      @default(1)
  /// Only aliases confirmed enough times are trusted for matching.
  isApproved   Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([normalizedText, productId])
  @@index([normalizedText, isApproved])
  @@map("product_aliases")
}

model QuoteItem {
  id                    String       @id @default(cuid())
  quoteRequestId        String
  quoteRequest          QuoteRequest @relation(fields: [quoteRequestId], references: [id], onDelete: Cascade)
  productId             String?
  product               Product?     @relation(fields: [productId], references: [id], onDelete: SetNull)
  name                  String
  quantity              Float        @default(1)
  unit                  String?
  notes                 String?
  confidence            Float?
  recognitionSourceLine String?
  position              Int          @default(0)
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  @@index([quoteRequestId, position])
  @@index([productId])
  @@map("quote_items")
}

model CustomerOrder {
  id                   String              @id @default(cuid())
  referenceCode        String              @unique
  proposalQuote QuoteRequest?
  userId               String
  user                 User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  status               OrderStatus         @default(PENDING_WHATSAPP)
  source               String              @default("public_cart")
  customerNameSnapshot String
  customerWhatsapp     String
  customerNote         String?
  internalNotes        String?
  whatsappUrl          String?
  whatsappMessage      String?
  whatsappRedirectedAt DateTime?
  recoveryStartedAt    DateTime?
  completedAt          DateTime?
  canceledAt           DateTime?
  items                CustomerOrderItem[]
  reservations         StockReservation[]
  sale                 Sale?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  @@index([referenceCode])
  @@index([userId])
  @@index([status])
  @@index([customerWhatsapp])
  @@index([whatsappRedirectedAt])
  @@map("customer_orders")
}

// ============================================================================
// SALE MODELS - Registered sales (fecha o ciclo de venda / faturamento)
// ============================================================================
enum PaymentMethod {
  PIX
  CASH
  CARD
  INSTALLMENT
}

enum SaleStatus {
  PAID
  PENDING_PAYMENT
  CANCELED
}

model Sale {
  id                   String        @id @default(cuid())
  referenceCode        String        @unique
  idempotencyKey       String?       @unique
  requestFingerprint   String?
  status               SaleStatus    @default(PAID)
  paymentMethod        PaymentMethod
  // Vínculos opcionais: cliente cadastrado e pedido de origem (checkout WhatsApp)
  customerId           String?
  customer             User?         @relation("SaleCustomer", fields: [customerId], references: [id], onDelete: SetNull)
  orderId              String?       @unique
  order                CustomerOrder? @relation(fields: [orderId], references: [id], onDelete: SetNull)
  // Quem registrou a venda no painel (colaborador interno)
  registeredById       String?
  registeredBy         User?         @relation("SaleRegisteredBy", fields: [registeredById], references: [id], onDelete: SetNull)
  // Snapshot do cliente para venda de balcão sem cadastro
  customerNameSnapshot String?
  customerWhatsapp     String?
  // Valores monetários
  subtotal             Float         @default(0) // Soma dos itens (bruto)
  discount             Float         @default(0) // Desconto aplicado no total
  total                Float         @default(0) // subtotal - discount (líquido)
  notes                String?
  paidAt               DateTime?
  canceledAt           DateTime?
  items                SaleItem[]
  stockMovements       StockMovement[]
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  @@index([referenceCode])
  @@index([status])
  @@index([paymentMethod])
  @@index([customerId])
  @@index([registeredById])
  @@index([createdAt])
  @@map("sales")
}

model SaleItem {
  id                  String   @id @default(cuid())
  saleId              String
  sale                Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId           String?
  product             Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productNameSnapshot String
  productSkuSnapshot  String?
  quantity            Int
  unitPrice           Float
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([saleId])
  @@index([productId])
  @@map("sale_items")
}

enum StockMovementType {
  SALE
  RESTOCK
  ADJUSTMENT
  RETURN
}

model StockMovement {
  id           String            @id @default(cuid())
  productId    String
  product      Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  type         StockMovementType
  quantity     Int               // Positivo = entrada, negativo = saída
  stockBefore  Int
  stockAfter   Int
  reason       String?
  saleId       String?
  sale         Sale?             @relation(fields: [saleId], references: [id], onDelete: SetNull)
  createdById  String?
  createdAt    DateTime          @default(now())

  @@index([productId])
  @@index([type])
  @@index([saleId])
  @@index([createdAt])
  @@map("stock_movements")
}

// ============================================================================
// SALES CHANNEL MODELS - Marketplaces e outros canais externos (Fase 3)
// ============================================================================
enum ChannelType {
  MERCADO_LIVRE
  SHOPEE
  AMAZON
  MAGALU
  CASAS_BAHIA
  AMERICANAS
  SHEIN
  MANUAL // Canal genérico controlado à mão (ponto de partida sem integração)
}

enum ChannelStatus {
  DISCONNECTED // Cadastrado, sem credenciais válidas
  CONNECTED    // Pronto para publicar/sincronizar
  ERROR        // Última operação falhou
}

enum ListingSyncStatus {
  DRAFT        // Ainda não publicado no canal
  SYNCED       // Publicado e em dia com a loja
  OUT_OF_SYNC  // Loja mudou (preço/estoque) e o canal está defasado
  ERROR        // Falha na última sincronização
}

model Channel {
  id            String        @id @default(cuid())
  type          ChannelType
  name          String        // Rótulo dado pelo lojista (ex.: "Mercado Livre - Loja Rebequi")
  status        ChannelStatus @default(DISCONNECTED)
  // Credenciais/config criptografadas em JSON string (mesmo padrão do Setting/crypto.util).
  credentials   String?
  externalId    String?       // Id da conta/loja no marketplace
  isActive      Boolean       @default(true)
  lastSyncedAt  DateTime?
  lastError     String?
  listings      ChannelListing[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([type])
  @@index([status])
  @@index([isActive])
  @@map("channels")
}

model ChannelListing {
  id               String            @id @default(cuid())
  channelId        String
  channel          Channel           @relation(fields: [channelId], references: [id], onDelete: Cascade)
  productId        String
  product          Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  externalListingId String?          // Id do anúncio no marketplace
  externalUrl      String?
  syncStatus       ListingSyncStatus @default(DRAFT)
  // Snapshot do que foi publicado — para detectar defasagem contra a loja (fonte única).
  publishedPrice   Float?
  publishedStock   Int?
  lastSyncedAt     DateTime?
  lastError        String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@unique([channelId, productId])
  @@index([channelId, syncStatus])
  @@index([productId])
  @@map("channel_listings")
}

model CustomerOrderItem {
  id                      String        @id @default(cuid())
  orderId                 String
  order                   CustomerOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId               String?
  product                 Product?      @relation(fields: [productId], references: [id], onDelete: SetNull)
  productNameSnapshot     String
  productSlugSnapshot     String
  productImageUrlSnapshot String?
  quantity                Int
  unitPrice               Float
  originalPrice           Float?
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  @@index([orderId])
  @@index([productId])
  @@map("customer_order_items")
}

// ============================================================================
// SETTING MODEL - Key/value store for integrations and runtime configuration
// ============================================================================
model Setting {
  key         String   @id
  value       String
  isSecret    Boolean  @default(false)
  description String?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@map("settings")
}

// Persistent outbox: committed with catalog/stock changes, consumed with a lease.
model IntegrationJob {
  id            String   @id @default(cuid())
  dedupeKey     String   @unique
  kind          String
  productId     String?
  channelId     String?
  status        String   @default("PENDING")
  attempts      Int      @default(0)
  nextAttemptAt DateTime @default(now())
  leaseUntil    DateTime?
  leaseToken    String?
  lastError     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status, nextAttemptAt])
  @@index([leaseUntil])
  @@index([channelId, createdAt])
  @@map("integration_jobs")
}

model IntegrationAudit {
  id        String   @id @default(cuid())
  actorId   String
  jobId     String
  action    String
  createdAt DateTime @default(now())

  @@index([jobId, createdAt])
  @@index([createdAt])
  @@map("integration_audits")
}

model StockReservation {
  id        String   @id @default(cuid())
  orderId   String
  order     CustomerOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int
  status    String   @default("ACTIVE")
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orderId, productId])
  @@index([status, expiresAt])
  @@map("stock_reservations")
}

enum PartnerStatus {
  PENDING
  APPROVED
  SUSPENDED
  REJECTED
}

model PartnerProfile {
  id                String @id @default(cuid())
  userId            String @unique
  user              User @relation(fields: [userId], references: [id], onDelete: Cascade)
  referralCode      String @unique
  specialties       String[]
  city              String
  region            String
  services          String @default("")
  experienceYears   Int @default(0)
  status            PartnerStatus @default(PENDING)
  reviewReason      String?
  reviewedById      String?
  reviewedAt        DateTime?
  acceptedTermsVersion String
  acceptedTermsAt   DateTime @default(now())
  version           Int @default(1)
  audits            PartnerProfileAudit[]
  projects          PartnerProject[]
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([status, createdAt])
  @@map("partner_profiles")
}

model PartnerProfileAudit {
  id        String @id @default(cuid())
  partnerId String
  partner   PartnerProfile @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  actorId   String
  action    String
  fromStatus PartnerStatus?
  toStatus PartnerStatus
  reason    String?
  createdAt DateTime @default(now())

  @@index([partnerId, createdAt])
  @@map("partner_profile_audits")
}

model PartnerProject {
  id String @id @default(cuid())
  requestKey String? @unique
  fingerprint String?
  partnerId String
  partner PartnerProfile @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  title String
  service String
  reference String @default("")
  clientName String @default("")
  notes String @default("")
  rooms Json
  archived Boolean @default(false)
  version Int @default(1)
  estimates MaterialEstimate[]
  laborQuotes PartnerLaborQuote[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([partnerId, archived, updatedAt])
  @@map("partner_projects")
}

model ProductTechnicalSpec {
  productId String @id
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  parameters Json
  sourceUrl String
  checkedById String
  checkedAt DateTime @default(now())
  version Int @default(1)
  @@map("product_technical_specs")
}

model MaterialEstimate {
  id String @id @default(cuid())
  projectId String
  project PartnerProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  requestKey String @unique
  fingerprint String
  input Json
  result Json
  quoteId String? @unique
  quote QuoteRequest? @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  @@index([projectId, createdAt])
  @@map("material_estimates")
}

model PartnerLaborQuote {
  id String @id @default(cuid())
  projectId String
  project PartnerProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  version Int
  requestKey String @unique
  fingerprint String
  title String
  projectTitleSnapshot String
  professionalNameSnapshot String
  clientNameSnapshot String @default("")
  items Json
  notes String @default("")
  totalCents BigInt
  validUntil DateTime
  createdAt DateTime @default(now())
  @@unique([projectId, version])
  @@index([projectId, createdAt])
  @@map("partner_labor_quotes")
}

model QuoteProposal {
  id String @id @default(cuid())
  quoteId String
  quote QuoteRequest @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  version Int
  requestKey String @unique
  fingerprint String
  createdById String
  items Json
  notes String @default("")
  totalCents BigInt
  validUntil DateTime
  createdAt DateTime @default(now())
  @@unique([quoteId, version])
  @@index([quoteId, createdAt])
  @@map("quote_proposals")
}
