  lastError     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status, nextAttemptAt])
  @@index([leaseUntil])
  @@index([channelId, createdAt])
  @@map("integration_jobs")
}

